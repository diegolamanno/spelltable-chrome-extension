# Copy this file to .env.dev (dev databases) and .env.prod (prod databases).
# Neither file should be committed — both are gitignored.
#
# Build commands:
#   npm run build:dev   → loads .env.dev
#   npm run build:prod  → loads .env.prod
#   npm run build       → loads .env (legacy fallback)

# Notion integration token (from https://www.notion.so/my-integrations)
VITE_NOTION_API_KEY=

# Notion database IDs (found in the database URL: notion.so/<workspace>/<DATABASE_ID>?v=...)
VITE_NOTION_PLAYERS_DB_ID=
VITE_NOTION_DECKS_DB_ID=
VITE_NOTION_GAMES_DB_ID=
VITE_NOTION_GAME_SEATS_DB_ID=

# Debug: set to "true" in .env.dev only — never in .env or .env.prod.
# .env is loaded for all modes, so setting it there bleeds into prod builds.
VITE_DEBUG_SINGLE_PLAYER=

# Debug: set to "true" in .env.dev to log Convoke's match/game API traffic to the console
# (entrypoints/convoke-logger.content.ts). Export after a game with:
#   copy(JSON.stringify(window.__edhLog, null, 2))
VITE_CONVOKE_LOGGER=
