# Notion integration token (from https://www.notion.so/my-integrations)
VITE_NOTION_API_KEY=

# Notion database IDs (found in the database URL: notion.so/<workspace>/<DATABASE_ID>?v=...)
VITE_NOTION_PLAYERS_DB_ID=
VITE_NOTION_DECKS_DB_ID=
VITE_NOTION_GAMES_DB_ID=

# Debug: allow submitting with a single synthetic player when no players are detected.
# Useful for testing the full submission flow without needing a real SpellTable game.
# Set to "true" to enable. Never use in production.
VITE_DEBUG_SINGLE_PLAYER=
